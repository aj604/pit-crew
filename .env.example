# Pit Crew Runtime Configuration
# Copy to `.env` (`cp .env.example .env`) and fill in values before running live cycles.

# Required for live Gemini 4 Managed Agent lanes (`gemini-4-hydrogen`, `gemini-4-neon`, `gemini-4-carbon`).
GEMINI_API_KEY=

# Fine-grained GitHub PAT scoped strictly to your target fork repository:
#   - Contents: Read and write
#   - Actions: Read and write
#   - Pull requests: Read and write
#   - Webhooks: Read and write (only needed for `register-webhook`)
# Never enters the remote agent sandbox; held exclusively on the Dispatcher host.
GITHUB_TOKEN=

# 32-byte hex HMAC secret verifying `X-Hub-Signature-256` on `POST /webhooks/github`.
# Generate with: openssl rand -hex 32
PIT_CREW_WEBHOOK_SECRET=

# Optional Bearer token protecting `/api/repos/*` and `POST /triggers/cycle` when exposed publicly.
# Generate with: openssl rand -hex 32
PIT_CREW_API_TOKEN=

# Path to WAL-mode SQLite ledger shared between Dispatcher, webhooks, and Pit Wall UI.
PIT_CREW_LEDGER_PATH=.pit_crew/ledger.db

# Optional persistent directory for replay MP4 recordings (served at /media/<file>.mp4).
# Leave unset to use <ledger_dir>/media locally and /data/media in Docker / Modal deployments.
# PIT_CREW_MEDIA_DIR=.pit_crew/media

# Optional public base URL of the deployed Pit Crew server (e.g. https://<app>.modal.run)
# so kept pull requests link directly to playable/downloadable .mp4 replay videos.
PIT_CREW_PUBLIC_URL=

# Optional path to a local target-repo checkout for the Analysis lane (auto-materialized when unset).
PIT_CREW_WORKSPACE=
